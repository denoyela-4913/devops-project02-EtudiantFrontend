{
  "name": "etudiant-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest --runInBand",
    "posttest": "node test-report-support/generate-entry-point.js",
    "test:watch": "jest --watch --runInBand",
    "compodoc": "npx compodoc -p src/tsconfig.app.json",
    "compodoc:serve": "npx compodoc -p src/tsconfig.app.json -s",
    "compodoc:serve:watch": "npx compodoc -p src/tsconfig.app.json -s --watch",
    "e2e": "ng e2e",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:component": "cypress run --component"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.1.4",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^20.3.27",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/material": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/platform-browser-dynamic": "^22.1.4",
    "@angular/router": "^22.1.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.22",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^19.2.0",
    "@compodoc/compodoc": "^1.1.32",
    "@cypress/schematic": "^4.3.0",
    "@types/jest": "^29.5.4",
    "cypress": "15.21.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "^17.0.0",
    "typescript": "~5.7.2"
  }
}
